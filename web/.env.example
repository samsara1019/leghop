# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local은 git에 올라가지 않는다.

# 필수 — Maps JavaScript / Places (New) / Directions 가 활성화된 키.
# 반드시 HTTP 리퍼러 제한을 걸 것 (브라우저에 노출되는 키다).
VITE_GOOGLE_MAPS_API_KEY=

# 선택 — Advanced Marker / 지도 스타일링에 필요. P1부터 사실상 필수.
# 콘솔 > 지도 관리 에서 Map ID 생성 (Vector 타입)
VITE_GOOGLE_MAPS_MAP_ID=

# 선택 — Gemini 중계 Worker 주소. 비우면 텍스트 파서(P3)만 비활성화된다.
# 로컬: http://localhost:8787
VITE_WORKER_URL=

# ---- Supabase (필수) ----
# 콘솔 > Project Settings > API 에서 복사
# anon key는 브라우저에 노출되는 공개 키다. RLS가 실제 방어선이므로
# service_role 키는 절대 여기 넣지 말 것.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
